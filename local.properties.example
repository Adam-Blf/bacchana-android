# Copy this file to local.properties (gitignored) and fill in your own values.
# local.properties is never committed - see .gitignore.

# Android SDK location (auto-generated by Android Studio, adjust for your machine).
sdk.dir=/path/to/Android/sdk

# RevenueCat public SDK key (Android). Leave blank to run in guest mode: the app
# builds and runs fine with no key, purchases are simply disabled ("Bientot disponible").
REVENUECAT_API_KEY=

# PostHog project API key (EU instance, https://eu.i.posthog.com). Leave blank to
# keep analytics fully inert - no init, no network call, regardless of user consent.
POSTHOG_API_KEY=
